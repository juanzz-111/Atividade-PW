<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividade</title>
    <h1>Mudar o Texto ao interagir com o Botão</h1>
</head>
<body>
    <p id="p1">Texto qualquer</p>
    <button onclick="meubutton()">Aperte aqui</button>

    <script>
        function meubutton(){
            document.getElementById("p1").innerText = "Esse sim é o texto"
        }
    </script>

</body>
</html>
