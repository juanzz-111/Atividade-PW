<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Atividade</title>
    <h1>Exibir Números de 1 a 10</h1>
</head>
<body>

  <button onclick="mostrar()">Mostrar Números</button>

  <div id="resultado"></div>

  <script>
    function mostrar() {
      let texto = "";

      for ( i = 1; i <= 10; i++) {
        texto += i + "<br>";
      }

      document.getElementById("resultado").innerHTML = texto;
    }
  </script>

</body>
</html>
